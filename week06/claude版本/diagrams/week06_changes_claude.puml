@startuml
' 第六週（claude 版本）：重構後有變動的兩個類別（投影片用）；完整圖見 week06_mission_claude.puml
skinparam classAttributeIconSize 0
hide circle

class Mission {
  - rover : Rover {readOnly}
  - steps : ArrayList<MissionStep> {readOnly}
  + Mission(rover : Rover)
  + run(script : int[]) : void
  + getOutcome() : String
  + getStepCount() : int
  + getStep(index : int) : MissionStep
  + countCommands() : int[]
  + countOk() : int
  + countRejected() : int
  + lowestEnergy() : int
}
class Rover {
  + {static} CAPACITY : int = 20
  + {static} TARGET_SAMPLES : int = 5
  - energy : int
  - samples : int
  - actionCount : int
  + Rover(energy : int, samples : int)
  + getEnergy() : int
  + getSamples() : int
  + getActionCount() : int
  + isSuccess() : boolean
  + isExhausted() : boolean
  + isStopped() : boolean
  + execute(command : int) : String
  - explore() : String
  - scan() : String
  - charge() : String
}

Mission -right-> "1" Rover : rover
@enduml
