@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 18
hide circle
object "h : HeavyRover（同一個物件）" as h {
  Rover宣告的energy = 20
  Rover宣告的samples = 0
  Rover宣告的actionCount = 0
