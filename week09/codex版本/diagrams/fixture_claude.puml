@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam defaultFontName "Microsoft JhengHei"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam classBorderColor #555555
skinparam noteBackgroundColor #FFFBEA
skinparam noteBorderColor #B39B4D
skinparam backgroundColor #FFFFFF
hide circle
hide empty members
title 範例三：同一個介面 Weighable，兩種寫法的實作類別

interface Weighable <<interface>> {
  + getWeight() : int
}
class FixtureDemo {
  + {static} main(args : String[]) : void
  - {static} show(item : Weighable) : void
}
class "FixtureDemo.FixedWeight" as Fixed <<private static 巢狀類別>> #DFF3E3 {
  + getWeight() : int  {回 2}
}
class "（匿名類別）" as Anon <<寫在 main 裡的 new Weighable() { ... }>> #FFE8D6 {
  + getWeight() : int  {回 2}
}
FixtureDemo +-- Fixed
Weighable <|.. Fixed
Weighable <|.. Anon
FixtureDemo ..> Anon : main 當場建立
FixtureDemo ..> Weighable : show 參數
@enduml
